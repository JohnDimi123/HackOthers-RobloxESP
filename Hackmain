local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function aimPart(char)
	if Aim.Part == "Head" then
		return char:FindFirstChild("Head")
	end
	return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

local function aimOrigin(cam)
	if UserInputService.MouseEnabled and UserInputService.MouseBehavior == Enum.MouseBehavior.Default then
		return UserInputService:GetMouseLocation()
	end
	return cam.ViewportSize / 2
end

local function isAimHeld()
	if not Aim.Hold then return true end
	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return true end
	if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL2) then return true end
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then return true end -- phones
	return false
end

-- Returns the part to aim at and its screen distance from the aim origin
local function checkTarget(plr, cam, origin)
	if plr == player then return nil end
	local char = plr.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	if not Aim.Teammates and plr.Team and plr.Team == player.Team then return nil end
	local part = aimPart(char)
	if not part then return nil end

	local sp, onScreen = cam:WorldToViewportPoint(part.Position)
	if not onScreen then return nil end
	local d = (Vector2.new(sp.X, sp.Y) - origin).Magnitude

	if Aim.WallCheck then
		local ignore = { char }
		if player.Character then
			table.insert(ignore, player.Character)
		end
		rayParams.FilterDescendantsInstances = ignore
		local from = cam.CFrame.Position
		if workspace:Raycast(from, part.Position - from, rayParams) then
			return nil
		end
	end
	return part, d, Vector2.new(sp.X, sp.Y)
end

local aimOn = false

RunService:BindToRenderStep("HackOthersAimbot", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if not aimOn then
		fovCircle.Visible = false
		marker.Visible = false
		aimTarget = nil
		return
	end

	local cam = workspace.CurrentCamera
	local origin = aimOrigin(cam)
	local holding = isAimHeld()

	fovCircle.Visible = Aim.ShowFOV
	fovCircle.Position = UDim2.fromOffset(origin.X, origin.Y)
	fovCircle.Size = UDim2.fromOffset(Aim.FOV * 2, Aim.FOV * 2)

	-- Keep the current target while it stays valid (stops flicker between players)
	local bestPlr, bestPart, bestD, bestScreen
	if aimTarget then
		local part, d, screen = checkTarget(aimTarget, cam, origin)
		if part and d <= Aim.FOV * 1.3 then
			bestPlr, bestPart, bestD, bestScreen = aimTarget, part, d, screen
		end
	end
	if not bestPlr then
		for _, plr in ipairs(Players:GetPlayers()) do
			local part, d, screen = checkTarget(plr, cam, origin)
			if part and d <= Aim.FOV and (not bestD or d < bestD) then
				bestPlr, bestPart, bestD, bestScreen = plr, part, d, screen
			end
		end
	end
	aimTarget = bestPlr

	local lockColor = holding and THEME.Danger or THEME.Muted
	fovStroke.Color = bestPlr and lockColor or THEME.Accent

	if bestPart then
		marker.Visible = Aim.ShowMarker
		marker.Position = UDim2.fromOffset(bestScreen.X, bestScreen.Y)
		markerStroke.Color = lockColor
		markerDot.BackgroundColor3 = lockColor
		aimPill.info.Text = (holding and "Locked: " or "Target: ") .. bestPlr.DisplayName

		if holding then
			local camPos = cam.CFrame.Position
			local goal = CFrame.lookAt(camPos, bestPart.Position)
			local alpha = 1 - (Aim.Smoothness ^ (dt * 60))
			cam.CFrame = cam.CFrame:Lerp(goal, alpha)
		end
	else
		marker.Visible = false
		aimPill.info.Text = "No target"
	end
end)

