		aimSub.Text, aimSub.TextColor3 = "Locked", THEME.Muted
	else
		aimSub.Text = Aim.Enabled and "On · locks onto the nearest player" or "Off · auto-aim at other players"
		aimSub.TextColor3 = Aim.Enabled and THEME.Danger or THEME.Muted
	end
end

setESPEnabled = function(on)
	if on and not hasESP() then return end
	if on == Settings.Enabled then return end
	Settings.Enabled = on
	espSwitch.set(on)
	setESP(on)
	espPill.on = on
	layoutPills()
	refreshCardText()
	refreshLauncher()
	if on then
		playOnFX(THEME.Accent)
		popLauncher()
	end
end

setAimEnabled = function(on)
	if on and not hasAimbot() then return end
	if on == Aim.Enabled then return end
	Aim.Enabled = on
	aimOn = on
	aimSwitch.set(on)
	aimPill.on = on
	layoutPills()
	refreshCardText()
	refreshLauncher()
	if on then
		playOnFX(THEME.Danger)
		popLauncher()
	end
end

ContextActionService:BindAction("HackOthers_ESPToggle", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		setESPEnabled(not Settings.Enabled)
	end
	return Enum.ContextActionResult.Sink
end, false, ESP_KEY, ESP_PAD)

ContextActionService:BindAction("HackOthers_AimToggle", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		setAimEnabled(not Aim.Enabled)
	end
	return Enum.ContextActionResult.Sink
end, false, AIM_KEY, AIM_PAD)

ContextActionService:BindAction("HackOthers_Menu", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		setMenu(not menuOpen)
	end
	return Enum.ContextActionResult.Sink
end, false, MENU_KEY)

local function refreshOwnership()
	if not hasESP() then
		setESPEnabled(false)
	end
	if not hasAimbot() then
		setAimEnabled(false)
	end
	local any = hasESP() or hasAimbot()
	launcherHolder.Visible = any
	if not any then
		setMenu(false)
	end
	refreshCardText()
end
player:GetAttributeChangedSignal("HasESP"):Connect(refreshOwnership)
player:GetAttributeChangedSignal("HasAimbot"):Connect(refreshOwnership)
refreshOwnership()

--------------------------------------------------------------------------------
-- Main loop (animations + ESP tags)
--------------------------------------------------------------------------------
local lastTagUpdate = 0

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	local pulse = (math.sin(t * 5) + 1) / 2
	local anyOn = espOn or aimOn

	for _, g in ipairs(rotating) do
		g.Rotation = (g.Rotation + dt * (anyOn and 200 or 45)) % 360
	end

	local lookSpeed = anyOn and 3 or 1.2
	for _, e in ipairs(irises) do
		e.iris.Position = UDim2.new(
			0.5, math.sin(t * lookSpeed) * e.range,
			0.5, math.cos(t * lookSpeed * 0.7) * 1.5
		)
	end

	if anyOn then
		launcherGlow.BackgroundTransparency = 0.72 + pulse * 0.2
	end
	espPill.dot.BackgroundTransparency = pulse * 0.7
	aimPill.dot.BackgroundTransparency = pulse * 0.7
	marker.Rotation = 45 + math.sin(t * 4) * 8

	-- Update ESP tags ~10x per second
	if espOn and t - lastTagUpdate > 0.1 then
		lastTagUpdate = t
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local origin = root and root.Position or workspace.CurrentCamera.CFrame.Position
		local unlimited = Settings.MaxDistance >= MAX_RANGE
		local seen = 0

		for _, info in pairs(targets) do
			if info.head.Parent then
				local d = (info.head.Position - origin).Magnitude
				local inRange = unlimited or d <= Settings.MaxDistance
				info.highlight.Enabled = inRange
				info.billboard.Enabled = inRange
				if inRange then
					seen += 1
					info.dist.Text = ("%dm"):format(math.floor(d + 0.5))
					local maxHp = info.humanoid.MaxHealth
					local hp = maxHp > 0 and math.clamp(info.humanoid.Health / maxHp, 0, 1) or 0
					info.hpFill.Size = UDim2.fromScale(hp, 1)
					info.hpFill.BackgroundColor3 = THEME.Danger:Lerp(THEME.Good, hp)
				end
			end
		end

		espPill.info.Text = seen .. " seen"
	end
end)
