end

local function playReadyFX()
	showToast("ESP ready", THEME.Good)
	glow.BackgroundColor3 = THEME.Good
	glow.BackgroundTransparency = 0.6
	tween(glow, 0.8, { BackgroundTransparency = 1 }).Completed:Connect(function()
		glow.BackgroundColor3 = THEME.Accent
	end)
	cardScale.Scale = 1.1
	tween(cardScale, 0.4, { Scale = hovering and 1.06 or 1 }, Enum.EasingStyle.Back)
end

local function applyStateStyle(state)
	if state == "active" then
		status.Text = "ACTIVE"
		status.TextColor3 = THEME.Accent
		barGrad.Color = ColorSequence.new(THEME.Accent, THEME.Accent2)
		eyeStroke.Color = THEME.Accent
		iris.BackgroundColor3 = THEME.Accent
		cdOverlay.Visible = false
		cdText.Text = ""
	elseif state == "cooling" then
		status.Text = "RECHARGING"
		status.TextColor3 = THEME.Muted
		barGrad.Color = ColorSequence.new(THEME.Muted, THEME.Muted)
		eyeStroke.Color = THEME.Muted
		iris.BackgroundColor3 = THEME.Muted
		cdOverlay.Visible = true
	else
		status.Text = "READY"
		status.TextColor3 = THEME.Good
		barGrad.Color = ColorSequence.new(THEME.Accent, THEME.Accent2)
		eyeStroke.Color = THEME.Accent
		iris.BackgroundColor3 = THEME.Accent
		cdOverlay.Visible = false
		cdText.Text = ""
		barFill.Size = UDim2.fromScale(1, 1)
	end
end

--------------------------------------------------------------------------------
-- Main loop
--------------------------------------------------------------------------------
local uiState = nil
local edgeStrength = 0
local lastTagUpdate = 0

RunService.RenderStepped:Connect(function(dt)
	local t = now()
	local endsAt, readyAt = getTimes()
	local state = (t < endsAt and "active") or (t < readyAt and "cooling") or "ready"

	if state ~= uiState then
		local prev = uiState
		uiState = state
		applyStateStyle(state)
		setESP(state == "active")
		if prev ~= nil then
			if state == "active" then
				playActivateFX()
			elseif prev == "active" then
				playEndFX()
			elseif state == "ready" and prev == "cooling" then
				playReadyFX()
			end
		end
	end

	local pulse = (math.sin(t * 6) + 1) / 2
	local active = state == "active"

	-- Animated border + eye
	strokeGrad.Rotation = (strokeGrad.Rotation + dt * (active and 260 or 50)) % 360
	local lookSpeed = active and 3 or 1.2
	iris.Position = UDim2.new(0.5, math.sin(t * lookSpeed) * 9, 0.5, math.cos(t * lookSpeed * 0.7) * 2)

	-- Edge glow eases in and out
	edgeStrength += ((active and 1 or 0) - edgeStrength) * math.min(dt * 6, 1)
	for _, e in ipairs(edges) do
		e.BackgroundTransparency = 1 - edgeStrength * (0.22 + pulse * 0.08)
	end

	if active then
		local rem = endsAt - t
		local frac = math.clamp(rem / DURATION, 0, 1)
		barFill.Size = UDim2.fromScale(frac, 1)
		bannerFill.Size = UDim2.fromScale(frac, 1)
		bannerTime.Text = ("%.1fs"):format(rem)
		liveDot.BackgroundTransparency = pulse * 0.7

		local n = 0
		for _ in pairs(targets) do
			n += 1
		end
		bannerSub.Text = n == 1 and "1 target revealed" or (n .. " targets revealed")
	elseif state == "cooling" then
		local rem = readyAt - t
		setCooldownFill(rem / COOLDOWN)
		cdText.Text = rem >= 10 and tostring(math.ceil(rem)) or ("%.1f"):format(rem)
		barFill.Size = UDim2.fromScale(math.clamp(1 - rem / COOLDOWN, 0, 1), 1)
	end

	-- Update tags ~10x per second
	if espOn and t - lastTagUpdate > 0.1 then
		lastTagUpdate = t
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local origin = root and root.Position or workspace.CurrentCamera.CFrame.Position
		for _, info in pairs(targets) do
			if info.head.Parent then
				info.dist.Text = ("%dm"):format(math.floor((info.head.Position - origin).Magnitude + 0.5))
				local maxHp = info.humanoid.MaxHealth
				local hp = maxHp > 0 and math.clamp(info.humanoid.Health / maxHp, 0, 1) or 0
				info.hpFill.Size = UDim2.fromScale(hp, 1)
				info.hpFill.BackgroundColor3 = THEME.Danger:Lerp(THEME.Good, hp)
			end
		end
	end
end)
