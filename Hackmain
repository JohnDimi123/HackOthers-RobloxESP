--------------------------------------------------------------------------------
-- ESP rendering
--------------------------------------------------------------------------------
local espOn = false
local targets = {}      -- [Player] = info
local playerConns = {}  -- [Player] = CharacterAdded connection

local function targetColor(plr)
	if plr.Team then
		return plr.TeamColor.Color
	end
	return THEME.Danger
end

local function detach(plr, instant)
	local info = targets[plr]
	if not info then return end
	targets[plr] = nil
	for _, c in ipairs(info.conns) do
		c:Disconnect()
	end
	if instant then
		info.highlight:Destroy()
		info.billboard:Destroy()
		return
	end
	tween(info.highlight, 0.25, { FillTransparency = 1, OutlineTransparency = 1 })
	tween(info.scale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.3, function()
		info.highlight:Destroy()
		info.billboard:Destroy()
	end)
end

local function attach(plr, character)
	detach(plr, true)
	if not espOn or plr == player then return end
	if not SHOW_TEAMMATES and plr.Team and plr.Team == player.Team then return end

	local humanoid = character:WaitForChild("Humanoid", 5)
	local head = character:WaitForChild("Head", 5)
	if not (humanoid and head) then return end
	if not espOn or plr.Character ~= character or targets[plr] then return end

	local color = targetColor(plr)

	-- Created on the client, so only this player can see it
	local highlight = make("Highlight", {
		Adornee = character,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		FillColor = color,
		FillTransparency = 1,
		OutlineColor = color,
		OutlineTransparency = 1,
		Parent = character,
	})
	tween(highlight, 0.4, { FillTransparency = 0.72, OutlineTransparency = 0 })

	local billboard = make("BillboardGui", {
		Name = "ESPTag_" .. plr.Name,
		Adornee = head,
		AlwaysOnTop = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Size = UDim2.fromOffset(160, 46),
		StudsOffset = Vector3.new(0, 2.6, 0),
		MaxDistance = math.huge,
		Parent = playerGui,
	})

	local panel = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.18,
		Parent = billboard,
	}, {
		corner(10),
		make("UIStroke", { Color = color, Thickness = 1.5, Transparency = 0.1 }),
	})
	local scale = make("UIScale", { Scale = 0, Parent = panel })

	make("TextLabel", {
		Position = UDim2.fromOffset(10, 5),
		Size = UDim2.new(1, -66, 0, 18),
		BackgroundTransparency = 1,
		Text = plr.DisplayName,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = panel,
	})

	local distLabel = make("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 5),
		Size = UDim2.fromOffset(54, 18),
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = THEME.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})

	local hpBg = make("Frame", {
		Position = UDim2.new(0, 10, 1, -15),
		Size = UDim2.new(1, -20, 0, 6),
		BackgroundColor3 = THEME.Track,
		BorderSizePixel = 0,
		Parent = panel,
	}, { corner(3) })

	local hpFill = make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = THEME.Good,
		BorderSizePixel = 0,
		Parent = hpBg,
	}, { corner(3) })

	tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)

	local info = {
		highlight = highlight,
		billboard = billboard,
		scale = scale,
		head = head,
		humanoid = humanoid,
		dist = distLabel,
		hpFill = hpFill,
		conns = {},
	}
	targets[plr] = info

	table.insert(info.conns, humanoid.Died:Connect(function()
		detach(plr)
	end))
	table.insert(info.conns, character.AncestryChanged:Connect(function(_, parent)
		if not parent then
			detach(plr, true)
		end
	end))
end

local function trackPlayer(plr)
	if plr == player or playerConns[plr] then return end
	playerConns[plr] = plr.CharacterAdded:Connect(function(char)
		attach(plr, char)
	end)
	if plr.Character then
		task.spawn(attach, plr, plr.Character)
	end
end

local function untrackPlayer(plr)
	if playerConns[plr] then
		playerConns[plr]:Disconnect()
		playerConns[plr] = nil
	end
	detach(plr)
end

Players.PlayerAdded:Connect(function(plr)
	if espOn then
		trackPlayer(plr)
	end
end)
Players.PlayerRemoving:Connect(untrackPlayer)

local function setESP(on)
	if on == espOn then return end
	espOn = on
	if on then
		for _, plr in ipairs(Players:GetPlayers()) do
			trackPlayer(plr)
		end
	else
		for plr in pairs(playerConns) do
			untrackPlayer(plr)
		end
		for plr in pairs(targets) do
			detach(plr)
		end
	end
end

