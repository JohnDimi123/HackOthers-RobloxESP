local function playOnFX()
	flash.BackgroundTransparency = 0.75
	tween(flash, 0.7, { BackgroundTransparency = 1 })

	scan.Position = UDim2.fromScale(0, 0)
	scan.BackgroundTransparency = 0
	tween(scan, 0.75, { Position = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		.Completed:Connect(function()
			scan.BackgroundTransparency = 1
		end)

	tween(statusPill, 0.5, { Position = PILL_SHOWN }, Enum.EasingStyle.Back)
	launcherScale.Scale = 1.18
	tween(launcherScale, 0.45, { Scale = launcherHover and 1.08 or 1 }, Enum.EasingStyle.Back)
end

local function playOffFX()
	tween(statusPill, 0.35, { Position = PILL_HIDDEN }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween(launcherGlow, 0.3, { BackgroundTransparency = 1 })
end

setEnabled = function(on)
	if on and not hasESP() then return end
	if on == Settings.Enabled then return end
	Settings.Enabled = on
	masterSwitch.set(on)
	masterSub.Text = on and "On · everyone is revealed" or "Off · tap to reveal everyone"
	masterSub.TextColor3 = on and THEME.Accent or THEME.Muted
	tween(launcherDot, 0.2, { BackgroundColor3 = on and THEME.Good or THEME.Track })
	setESP(on)
	if on then
		playOnFX()
	else
		playOffFX()
	end
end

