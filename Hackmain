		TextSize = 13,
		TextColor3 = THEME.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = card,
	})

	local track = make("Frame", {
		Position = UDim2.new(0, 14, 0, 40),
		Size = UDim2.new(1, -28, 0, 6),
		BackgroundColor3 = THEME.Track,
		BorderSizePixel = 0,
		Parent = card,
	}, { pill() })

	local fill = make("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	}, { pill(), make("UIGradient", { Color = ColorSequence.new(THEME.Accent, THEME.Accent2) }) })

	local knob = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = track,
	}, { pill(), make("UIStroke", { Color = THEME.Accent, Thickness = 2 }) })

	local hit = make("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 6, 0, 28),
		Size = UDim2.new(1, -12, 0, 30),
		ZIndex = 3,
		Parent = card,
	})

	local s = { track = track, knob = knob, page = content }
	function s.setFraction(f)
		f = math.clamp(f, 0, 1)
		local v = minV + (maxV - minV) * f
		fill.Size = UDim2.fromScale(f, 1)
		knob.Position = UDim2.fromScale(f, 0.5)
		valueLabel.Text = format(v)
		onChange(v)
	end
	function s.slideTo(x)
		s.setFraction((x - track.AbsolutePosition.X) / track.AbsoluteSize.X)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = s
			s.page.ScrollingEnabled = false
			tween(knob, 0.15, { Size = UDim2.fromOffset(20, 20) })
			s.slideTo(input.Position.X)
		end
	end)

	s.setFraction((value - minV) / (maxV - minV))
	return s
end

