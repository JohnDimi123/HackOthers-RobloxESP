-- Switch component
local function makeSwitch(parent, w, h, position, anchor)
	local track = make("Frame", {
		AnchorPoint = anchor,
		Position = position,
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = THEME.Track,
		Parent = parent,
	}, { pill() })
	local knob = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(h - 6, h - 6),
		BackgroundColor3 = THEME.Muted,
		Parent = track,
	}, { pill() })

	local sw = {}
	function sw.set(on, instant)
		local pos = on and UDim2.new(0, w - h + 3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		local trackColor = on and THEME.Accent or THEME.Track
		local knobColor = on and Color3.new(1, 1, 1) or THEME.Muted
		if instant then
			knob.Position, track.BackgroundColor3, knob.BackgroundColor3 = pos, trackColor, knobColor
		else
			tween(knob, 0.25, { Position = pos }, Enum.EasingStyle.Back)
			tween(track, 0.2, { BackgroundColor3 = trackColor })
			tween(knob, 0.2, { BackgroundColor3 = knobColor })
		end
	end
	return sw
end

local function section(text)
	make("TextLabel", {
