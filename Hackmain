local hovering = false
local lastRequest = 0

local function shake()
	task.spawn(function()
		for _, x in ipairs({ 9, -8, 6, -4, 2, 0 }) do
			tween(card, 0.04, { Position = UDim2.new(0.5, x, 0.5, 0) }, Enum.EasingStyle.Sine)
			task.wait(0.04)
		end
	end)
end

local function tryActivate()
	if not hasESP() then return end
	local endsAt, readyAt = getTimes()
	local t = now()
	if t < endsAt then
		showToast("ESP is already active", THEME.Accent)
		return
	end
	if t < readyAt then
		shake()
		showToast(("Recharging — %.1fs left"):format(readyAt - t), THEME.Danger)
		return
	end
	if t - lastRequest < 0.3 then return end
	lastRequest = t
	espEndsAt = t + DURATION
	espReadyAt = espEndsAt + COOLDOWN
end

