local espOn = false
local targets = {}      -- [Player] = info
local playerConns = {}  -- [Player] = { connections }

local function colorFor(plr)
	if Settings.UseTeamColors and plr.Team then
		return plr.TeamColor.Color
	end
	return Settings.Color
end

local function styleTarget(info)
	local c = colorFor(info.plr)
	local h = info.highlight
	h.FillColor = c
	h.OutlineColor = c
	h.FillTransparency = Settings.Fill and (1 - Settings.FillOpacity) or 1
	h.OutlineTransparency = Settings.Outline and 0 or 1
	info.stroke.Color = c

	info.name.Visible = Settings.Names
	info.dist.Visible = Settings.Distance
	info.hpBg.Visible = Settings.Health

	if Settings.Names then
		info.dist.AnchorPoint = Vector2.new(1, 0)
		info.dist.Position = UDim2.new(1, -10, 0, 5)
		info.dist.Size = UDim2.fromOffset(54, 18)
		info.dist.TextXAlignment = Enum.TextXAlignment.Right
	else
		info.dist.AnchorPoint = Vector2.new(0.5, 0)
		info.dist.Position = UDim2.new(0.5, 0, 0, 5)
		info.dist.Size = UDim2.new(1, -20, 0, 18)
		info.dist.TextXAlignment = Enum.TextXAlignment.Center
	end

	local top = Settings.Names or Settings.Distance
	info.hpBg.Position = UDim2.new(0, 10, 0, top and 28 or 8)
	local height = top and (Settings.Health and 42 or 28) or (Settings.Health and 22 or 0)
	info.panel.Size = UDim2.new(1, 0, 0, height)
	info.panel.Visible = height > 0
end

local function restyleAll()
	for _, info in pairs(targets) do
		styleTarget(info)
	end
end

local function detach(plr, instant)
	local info = targets[plr]
	if not info then return end
	targets[plr] = nil
	for _, c in ipairs(info.conns) do
		c:Disconnect()
	end
	if instant then
		info.highlight:Destroy()
		info.billboard:Destroy()
		return
	end
	tween(info.highlight, 0.25, { FillTransparency = 1, OutlineTransparency = 1 })
	tween(info.scale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.3, function()
		info.highlight:Destroy()
		info.billboard:Destroy()
	end)
end

local function attach(plr, character)
	detach(plr, true)
	if not espOn or plr == player or not character then return end
	if not Settings.Teammates and plr.Team and plr.Team == player.Team then return end

	local humanoid = character:WaitForChild("Humanoid", 5)
	local head = character:WaitForChild("Head", 5)
	if not (humanoid and head) then return end
	if not espOn or plr.Character ~= character or targets[plr] then return end
	if not Settings.Teammates and plr.Team and plr.Team == player.Team then return end

	-- Created on the client, so only this player sees it
	local highlight = make("Highlight", {
		Adornee = character,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Parent = character,
	})

	local billboard = make("BillboardGui", {
		Name = "ESPTag_" .. plr.Name,
		Adornee = head,
		AlwaysOnTop = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Size = UDim2.fromOffset(160, 46),
		StudsOffset = Vector3.new(0, 2.6, 0),
		MaxDistance = math.huge,
		Parent = playerGui,
	})

	local stroke = make("UIStroke", { Thickness = 1.5, Transparency = 0.1 })
	local panel = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.18,
		Parent = billboard,
	}, { corner(10), stroke })
	local scale = make("UIScale", { Scale = 0, Parent = panel })

	local nameLabel = make("TextLabel", {
		Position = UDim2.fromOffset(10, 5),
		Size = UDim2.new(1, -66, 0, 18),
		BackgroundTransparency = 1,
		Text = plr.DisplayName,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = panel,
	})

	local distLabel = make("TextLabel", {
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = THEME.Muted,
		Parent = panel,
	})

	local hpBg = make("Frame", {
		Size = UDim2.new(1, -20, 0, 6),
		BackgroundColor3 = THEME.Track,
		BorderSizePixel = 0,
		Parent = panel,
	}, { corner(3) })

	local hpFill = make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = THEME.Good,
		BorderSizePixel = 0,
		Parent = hpBg,
	}, { corner(3) })

	local info = {
		plr = plr,
		highlight = highlight,
		billboard = billboard,
		panel = panel,
		stroke = stroke,
		scale = scale,
		head = head,
		humanoid = humanoid,
		name = nameLabel,
		dist = distLabel,
		hpBg = hpBg,
		hpFill = hpFill,
		conns = {},
	}
	targets[plr] = info
	styleTarget(info)

	-- Fade in
	local fillGoal, outlineGoal = highlight.FillTransparency, highlight.OutlineTransparency
	highlight.FillTransparency, highlight.OutlineTransparency = 1, 1
	tween(highlight, 0.4, { FillTransparency = fillGoal, OutlineTransparency = outlineGoal })
	tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)

	table.insert(info.conns, humanoid.Died:Connect(function()
		detach(plr)
	end))
	table.insert(info.conns, character.AncestryChanged:Connect(function(_, parent)
		if not parent then
			detach(plr, true)
		end
	end))
end

local function trackPlayer(plr)
	if plr == player or playerConns[plr] then return end
	playerConns[plr] = {
		plr.CharacterAdded:Connect(function(char)
			attach(plr, char)
		end),
		plr:GetPropertyChangedSignal("Team"):Connect(function()
			if espOn and plr.Character then
				task.spawn(attach, plr, plr.Character)
			end
		end),
	}
	if plr.Character then
		task.spawn(attach, plr, plr.Character)
	end
end

local function untrackPlayer(plr)
	local conns = playerConns[plr]
	if conns then
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		playerConns[plr] = nil
	end
	detach(plr)
end

local function rebuild()
	if not espOn then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			task.spawn(attach, plr, plr.Character)
		end
	end
end

Players.PlayerAdded:Connect(function(plr)
	if espOn then
		trackPlayer(plr)
	end
end)
Players.PlayerRemoving:Connect(untrackPlayer)
player:GetPropertyChangedSignal("Team"):Connect(rebuild)

local function setESP(on)
	if on == espOn then return end
	espOn = on
	if on then
		for _, plr in ipairs(Players:GetPlayers()) do
			trackPlayer(plr)
		end
	else
		for plr in pairs(playerConns) do
			untrackPlayer(plr)
		end
		for plr in pairs(targets) do
			detach(plr)
		end
	end
end

