-- Helpers ---------------------------------------------------------------------
local function make(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r)
	return make("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function pill()
	return make("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

local function tween(inst, t, props, style, dir)
	local tw = TweenService:Create(
		inst,
		TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function hasESP()
	return player:GetAttribute("HasESP") ~= false
end

local function hasAimbot()
	return player:GetAttribute("HasAimbot") ~= false
end

local rotating = {} -- gradient borders that spin
local irises = {}   -- eye icons that look around

local function makeEye(parent, w, h, z)
	local stroke = make("UIStroke", { Thickness = 2.5, Color = THEME.Accent })
	local eye = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(w, h),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	}, { pill(), stroke })
	local s = math.floor(h * 0.6)
	local iris = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(s, s),
		BackgroundColor3 = THEME.Accent,
		ZIndex = z + 1,
		Parent = eye,
	}, { pill() })
	local p = math.max(3, math.floor(s * 0.4))
	make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(p, p),
		BackgroundColor3 = THEME.Panel,
		ZIndex = z + 2,
		Parent = iris,
	}, { pill() })
	table.insert(irises, { iris = iris, range = w * 0.17 })
	return eye
end

local function spinningStroke(parent, thickness)
	local stroke = make("UIStroke", {
		Thickness = thickness,
		Color = Color3.new(1, 1, 1),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
	local grad = make("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, THEME.Accent),
			ColorSequenceKeypoint.new(0.5, THEME.Accent2),
			ColorSequenceKeypoint.new(1, THEME.Accent),
		}),
		Parent = stroke,
	})
	table.insert(rotating, grad)
	return stroke
end

