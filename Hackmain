--------------------------------------------------------------------------------
-- Main loop
--------------------------------------------------------------------------------
local lastTagUpdate = 0

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	local pulse = (math.sin(t * 5) + 1) / 2

	for _, g in ipairs(rotating) do
		g.Rotation = (g.Rotation + dt * (espOn and 200 or 45)) % 360
	end

	local lookSpeed = espOn and 3 or 1.2
	for _, e in ipairs(irises) do
		e.iris.Position = UDim2.new(
			0.5, math.sin(t * lookSpeed) * e.range,
			0.5, math.cos(t * lookSpeed * 0.7) * 1.5
		)
	end

	if espOn then
		pillDot.BackgroundTransparency = pulse * 0.7
		launcherGlow.BackgroundTransparency = 0.72 + pulse * 0.2
	end

	-- Update tags ~10x per second
	if espOn and t - lastTagUpdate > 0.1 then
		lastTagUpdate = t
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local origin = root and root.Position or workspace.CurrentCamera.CFrame.Position
		local unlimited = Settings.MaxDistance >= MAX_RANGE
		local seen = 0

		for _, info in pairs(targets) do
			if info.head.Parent then
				local d = (info.head.Position - origin).Magnitude
				local inRange = unlimited or d <= Settings.MaxDistance
				info.highlight.Enabled = inRange
				info.billboard.Enabled = inRange
				if inRange then
					seen += 1
					info.dist.Text = ("%dm"):format(math.floor(d + 0.5))
					local maxHp = info.humanoid.MaxHealth
					local hp = maxHp > 0 and math.clamp(info.humanoid.Health / maxHp, 0, 1) or 0
					info.hpFill.Size = UDim2.fromScale(hp, 1)
					info.hpFill.BackgroundColor3 = THEME.Danger:Lerp(THEME.Good, hp)
				end
			end
		end

		pillCount.Text = seen .. " seen"
	end
end)
