--[[
	Hack Others — ESP Superpower (single script)
	Place in: StarterPlayer > StarterPlayerScripts  (as a LocalScript)

	Press Q (or tap the ESP button / gamepad Y) to activate.
	While active, every other player is outlined through walls with a
	floating tag showing their name, distance and health.

	To lock the power for a player, set on the server:
	  player:SetAttribute("HasESP", false)   -- hides the button
	  player:SetAttribute("HasESP", true)    -- shows it again
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Settings --------------------------------------------------------------------
local KEYBIND = Enum.KeyCode.Q
local GAMEPAD_BIND = Enum.KeyCode.ButtonY
local SHOW_TEAMMATES = true -- set false to only reveal players on other teams

local DURATION = 8   -- seconds ESP stays active
local COOLDOWN = 20  -- seconds to recharge after it ends

local THEME = {
	Panel   = Color3.fromRGB(14, 17, 24),
	PanelHi = Color3.fromRGB(34, 40, 56),
	Track   = Color3.fromRGB(30, 35, 48),
	Accent  = Color3.fromRGB(0, 229, 255),
	Accent2 = Color3.fromRGB(150, 90, 255),
	Text    = Color3.fromRGB(235, 240, 255),
	Muted   = Color3.fromRGB(130, 140, 165),
	Danger  = Color3.fromRGB(255, 64, 110),
	Good    = Color3.fromRGB(70, 255, 160),
}

-- Helpers ---------------------------------------------------------------------
local function make(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r)
	return make("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function tween(inst, t, props, style, dir)
	local tw = TweenService:Create(
		inst,
		TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function now()
	return os.clock()
end

local espEndsAt, espReadyAt = 0, 0
local function getTimes()
	return espEndsAt, espReadyAt
end

local function hasESP()
	return player:GetAttribute("HasESP") ~= false
end

