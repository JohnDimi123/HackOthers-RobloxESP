local function showToast(text, color)
	toastToken += 1
	local my = toastToken
	toast.Text = text
	toastStroke.Color = color or THEME.Accent
	toast.Position = TOAST_POS + UDim2.fromOffset(0, 10)
	tween(toast, 0.25, { BackgroundTransparency = 0.08, TextTransparency = 0, Position = TOAST_POS })
	tween(toastStroke, 0.25, { Transparency = 0.2 })
	task.delay(1.8, function()
		if my ~= toastToken then return end
		tween(toast, 0.35, { BackgroundTransparency = 1, TextTransparency = 1 })
		tween(toastStroke, 0.35, { Transparency = 1 })
	end)
end

