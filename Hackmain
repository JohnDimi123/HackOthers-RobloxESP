local function setRangeFraction(f)
	f = math.clamp(f, 0, 1)
	Settings.MaxDistance = math.floor(MIN_RANGE + (MAX_RANGE - MIN_RANGE) * f + 0.5)
	sliderFill.Size = UDim2.fromScale(f, 1)
	sliderKnob.Position = UDim2.fromScale(f, 0.5)
	rangeValue.Text = Settings.MaxDistance >= MAX_RANGE and "Unlimited" or (Settings.MaxDistance .. "m")
end
setRangeFraction((Settings.MaxDistance - MIN_RANGE) / (MAX_RANGE - MIN_RANGE))

local sliding = false
local function slideTo(x)
	setRangeFraction((x - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X)
end
sliderHit.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliding = true
		content.ScrollingEnabled = false
		tween(sliderKnob, 0.15, { Size = UDim2.fromOffset(20, 20) })
		slideTo(input.Position.X)
	end
end)

-- Menu dragging -----------------------------------------------------------------
local dragging, dragStart, startPos = false, nil, nil
header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = menu.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	local moving = input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	if not moving then return end
	if sliding then
		slideTo(input.Position.X)
	elseif dragging then
		local delta = input.Position - dragStart
		menu.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if sliding then
			sliding = false
			content.ScrollingEnabled = true
			tween(sliderKnob, 0.15, { Size = UDim2.fromOffset(16, 16) })
		end
		dragging = false
	end
end)

-- Open / close ------------------------------------------------------------------
local menuOpen = false
local function setMenu(open)
	if open and not hasESP() then return end
	menuOpen = open
	if open then
		menu.Visible = true
		menuScale.Scale = 0.85
		tween(menuScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		tween(menuScale, 0.18, { Scale = 0.85 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			.Completed:Connect(function()
				if not menuOpen then
					menu.Visible = false
				end
			end)
	end
end

launcher.Activated:Connect(function()
	setMenu(not menuOpen)
end)
closeBtn.Activated:Connect(function()
	setMenu(false)
end)

